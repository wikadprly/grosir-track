# PostgreSQL — gunakan connection string pooled + SSL untuk produksi
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Wajib minimal 32 karakter acak
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# PIN login awal, wajib tepat 6 digit (hanya dipakai saat seeding pertama)
SEED_PIN="111111"
